{
  "name": "Bedford Road Musical",
  "short_name": "Bedford Musical",
  "id": "/dashboard.html",
  "start_url": "/dashboard.html?source=installed",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0a0d",
  "theme_color": "#990016",
  "description": "Calls, announcements, rehearsal music, production workspaces, and learning tools for Bedford Road Musical.",
  "categories": ["education", "productivity", "music"],
  "icons": [
    { "src": "/assets/images/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/images/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/images/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/images/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My schedule", "short_name": "Schedule", "url": "/schedule.html", "icons": [{ "src":"/assets/images/icons/icon-192.png", "sizes":"192x192" }] },
    { "name": "Music and tracks", "short_name": "Tracks", "url": "/tracks.html", "icons": [{ "src":"/assets/images/icons/icon-192.png", "sizes":"192x192" }] },
    { "name": "Announcements", "short_name": "Updates", "url": "/announcements.html", "icons": [{ "src":"/assets/images/icons/icon-192.png", "sizes":"192x192" }] }
  ]
}
