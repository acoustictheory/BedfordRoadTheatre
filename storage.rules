rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /legacy-drive/{driveFileId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.fullAdmin == true;
    }
    match /production-documents/{productionId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.fullAdmin == true;
    }
    match /chat-attachments/{productionId}/{conversationId}/{messageId}/{fileName} {
      function principalId() { return request.auth.token.get('legacyUserId', request.auth.uid); }
      function room() { return firestore.get(/databases/(default)/documents/productions/$(productionId)/communicationConversations/$(conversationId)); }
      function isMember() { return request.auth != null && principalId() in room().data.memberIds; }
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.metadata.senderId == principalId();
      allow delete: if isMember() && resource.metadata.senderId == principalId();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
